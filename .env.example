# ─────────────────────────────────────────────────────────────
#  업비트 API 키 (5단계 실전용)
#  이 파일을 .env 로 복사해서 채울 것. .env 는 .gitignore 에 등록되어 있다.
# ─────────────────────────────────────────────────────────────
#
# ⚠️ 키 발급 시 반드시 지킬 것 (https://upbit.com/mypage/open_api_management)
#
#   1. **출금 권한을 절대 체크하지 말 것.**
#      pyupbit 에는 withdraw_cash / withdraw_coin 이 있다. 출금 권한이 있는 키가
#      유출되면 자산을 통째로 인출당한다. 이 봇은 출금 기능을 쓰지 않는다.
#      필요한 건 "자산조회"와 "주문" 둘뿐이다.
#
#   2. **IP 주소 화이트리스트를 등록할 것.** (업비트는 필수)
#      키가 유출돼도 등록된 IP 밖에서는 못 쓴다.
#
#   3. 키는 만료된다. 만료 전에 갱신할 것.
#
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
#  안전장치
# ─────────────────────────────────────────────────────────────
# 1회 주문 상한 (원). 오타로 0 하나 더 붙는 사고를 막는다.
UPBIT_MAX_ORDER_KRW=10000

# true 로 바꾸기 전까지 실주문이 차단된다. --live 플래그와 둘 다 있어야 열린다.
UPBIT_ALLOW_LIVE=false

# ─────────────────────────────────────────────────────────────
#  주문 방식
# ─────────────────────────────────────────────────────────────
# limit: 최우선 호가에 지정가 → 대기 → 미체결분 시장가 (스프레드 절감, 기본)
# market: 시장가만. 손절·긴급매도는 설정과 무관하게 항상 시장가다.
UPBIT_ORDER_TYPE=limit
UPBIT_LIMIT_WAIT_SEC=90

# ─────────────────────────────────────────────────────────────
#  모의(페이퍼) 모드
# ─────────────────────────────────────────────────────────────
# 모의 모드의 가상 원화. 실제 돈이 아니다.
UPBIT_PAPER_KRW=1000000

# ─────────────────────────────────────────────────────────────
#  알림 (선택)
# ─────────────────────────────────────────────────────────────
# Slack / Discord 웹훅 URL. 비워두면 알림을 보내지 않는다.
# 주문 체결·손절 발동·봇 중단 시 알려준다.
UPBIT_WEBHOOK_URL=
